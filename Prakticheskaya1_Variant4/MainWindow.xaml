<Window x:Class="Prakticheskaya1_Variant4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prakticheskaya1_Variant4"
        mc:Ignorable="d"
        Title="Практическая работа №1 - Вариант 4" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid>
        <Menu Height="25" VerticalAlignment="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="SaveFile_Click"/>
                <MenuItem Header="Открыть" Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Массив">
                <MenuItem Header="Заполнить случайными числами" Click="FillRandom_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
                <MenuItem Header="Изменить размер" Click="Resize_Click"/>
            </MenuItem>
            <MenuItem Header="Вычисления">
                <MenuItem Header="Выполнить обработку" Click="Process_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10,35,10,60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Исходный массив -->
            <GroupBox Grid.Column="0" Header="Исходный массив" Margin="0,0,5,0">
                <Grid>
                    <DataGrid x:Name="dgArray" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- Результаты -->
            <GroupBox Grid.Column="1" Header="Результаты обработки" Margin="5,0,0,0">
                <Grid>
                    <DataGrid x:Name="dgResults" AutoGenerateColumns="False" 
                              IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Индекс" Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="Число" Binding="{Binding Number}" Width="70"/>
                            <DataGridTextColumn Header="√x" Binding="{Binding SqrtValue}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Кнопки внизу -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Margin="0,0,0,15">
            <Button Content="Выполнить обработку" Width="150" Height="30" 
                    Margin="5" Click="Process_Click" FontWeight="Bold"/>
            <Button Content="О программе" Width="120" Height="30" 
                    Margin="5" Click="About_Click"/>
            <Button Content="Выход" Width="80" Height="30" 
                    Margin="5" Click="Exit_Click"/>
        </StackPanel>

        <!-- Статус бар -->
        <StatusBar Height="25" VerticalAlignment="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="tbStatus" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
